# Public local-development defaults for the independent doggy-clean Compose project.
# Change both service credentials and DATABASE_URL before a shared deployment.
HOST=127.0.0.1
PORT=3012
DB_DRIVER=postgres
DATABASE_URL=postgresql://doogy:doogy-local-dev@127.0.0.1:55433/doogy
DATA_MODE=offline
PG_TOOLS=docker
# Explicit SQLite import source only; not a fallback PostgreSQL data store.
DB_PATH=./data/doogy.db

FRESH_SECONDS=300
OFFLINE_SECONDS=300
LOW_BATTERY_PCT=20
IDEMPOTENCY_TTL_HOURS=24

# Comma-separated existing user UUIDs. Empty means no administrator access.
DEVICE_ADMIN_USER_IDS=
SUPPORT_ADMIN_USER_IDS=

MANAGED_BACKUP_ENABLED=false
MANAGED_BACKUP_DIRECTORY=./data/managed-backups
MANAGED_BACKUP_KEEP_COUNT=7
MANAGED_BACKUP_INTERVAL_HOURS=24

# API mode only: set DATA_MODE=api and configure actual adapter credentials.
# VENDOR_WEBHOOK_SECRET must contain at least 24 characters when enabled.
# VENDOR_WEBHOOK_SECRET=
# PUSH_WEBHOOK_URL=https://push-adapter.example/send
# PUSH_WEBHOOK_TOKEN=
# Supply DEVICE_TOKEN / DOOGY_ACCESS_TOKEN temporarily in the terminal, not here.
